   class ActionHistory {
     static async add(action) {
       const history = await Storage.get('action_history') || [];
       history.unshift({
         id: crypto.randomUUID(),
         ...action,
         timestamp: Date.now(),
         can_undo: Date.now() < action.created_at + 30000
       });
       
       // Keep last 50 actions
       const trimmed = history.slice(0, 50);
       await Storage.set('action_history', trimmed);
     }
     
     static async getAll() {
