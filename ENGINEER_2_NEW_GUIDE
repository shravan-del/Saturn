**Goal**: Build 7-layer validation to prevent bad calendar events

**Backend Tasks:**
1. **Guardian Core** (`utils/guardian.js`)
   ```javascript
   class Guardian {
     constructor() {
       this.layers = [
         new SanityCheckLayer(),
         new ConflictDetectionLayer(),
         new PatternAnalysisLayer(),
         new RiskScoringLayer(),
         new ModeDecisionLayer(),
         new WarningGenerationLayer(),
         new RecommendationLayer()
       ];
     }
     
     async validate(intent) {
       let context = { intent, calendar_events: [] };
       
       // Run through all 7 layers
       for (const layer of this.layers) {
         context = await layer.process(context);
       }
       
       return {
         mode: context.mode,           // auto/confirm/block
         risk_score: context.risk_score, // 0.0 - 1.0
         warnings: context.warnings,     // User warnings
         blockers: context.blockers,     // Blocking issues
         preview: context.preview        // Action preview text
       };
     }
   }
